cabal-version:   3.0
name:            havidrome
version:         0.1.0.0
synopsis:        A CLI player for a Navidrome server.
build-type:      Simple

common language
    default-language:   GHC2021
    default-extensions: DerivingStrategies
    ghc-options:        -Wall -Wcompat -Wredundant-constraints

library
    import:          language
    hs-source-dirs:  src
    exposed-modules:
        Havidrome
        Havidrome.Audio
        Havidrome.Audio.Ipc
        Havidrome.Audio.State
        Havidrome.Browse
        Havidrome.Browse.Screen
        Havidrome.Credentials
        Havidrome.Library
        Havidrome.Login
        Havidrome.Playback
        Havidrome.Playback.Queue
        Havidrome.Subsonic
        Havidrome.Subsonic.Protocol
        Havidrome.Subsonic.Transport
        Havidrome.Subsonic.Types

    build-depends:
        aeson,
        base,
        brick,
        bytestring,
        crypton,
        directory,
        filepath,
        http-client,
        http-client-tls,
        http-types,
        mtl,
        network,
        process,
        random,
        stm,
        text,
        transformers,
        unix,
        vector,
        vty

executable havidrome
    import:         language
    hs-source-dirs: app
    main-is:        Main.hs

    -- vty runs its input on threads of its own.
    ghc-options:    -threaded
    build-depends:  base, havidrome

test-suite havidrome-test
    import:         language
    type:           exitcode-stdio-1.0
    hs-source-dirs: test
    main-is:        Main.hs
    other-modules:
        CredentialsSpec
        HavidromeSpec
        Havidrome.AudioSpec
        Havidrome.Audio.IpcSpec
        Havidrome.Audio.StateSpec
        Havidrome.Browse.Fixtures
        Havidrome.Browse.ScreenSpec
        Havidrome.BrowseSpec
        Havidrome.LoginSpec
        Havidrome.Playback.QueueSpec
        Havidrome.Playback.Standin
        Havidrome.PlaybackSpec
        Havidrome.Subsonic.ClientSpec
        Havidrome.Subsonic.Fixtures
        Havidrome.Subsonic.ProtocolSpec
        Terminal

    build-depends:
        QuickCheck,
        aeson,
        base,
        brick,
        bytestring,
        containers,
        directory,
        filepath,
        havidrome,
        hspec,
        http-client,
        http-types,
        stm,
        temporary,
        text,
        transformers,
        unix,
        vector,
        vty
