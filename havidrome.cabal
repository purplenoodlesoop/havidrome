cabal-version:   3.0
name:            havidrome
version:         0.1.0.0
synopsis:        A CLI player for a Navidrome server.
build-type:      Simple

common language
    default-language:   GHC2021
    default-extensions: DerivingStrategies
    ghc-options:        -Wall -Wcompat -Wredundant-constraints

library
    import:          language
    hs-source-dirs:  src
    exposed-modules:
        Havidrome
        Havidrome.Credentials
        Havidrome.Subsonic
        Havidrome.Subsonic.Protocol
        Havidrome.Subsonic.Transport
        Havidrome.Subsonic.Types

    build-depends:
        aeson,
        base,
        bytestring,
        crypton,
        directory,
        filepath,
        http-client,
        http-client-tls,
        http-types,
        random,
        text,
        unix

executable havidrome
    import:         language
    hs-source-dirs: app
    main-is:        Main.hs
    build-depends:  base, havidrome

test-suite havidrome-test
    import:         language
    type:           exitcode-stdio-1.0
    hs-source-dirs: test
    main-is:        Main.hs
    other-modules:
        CredentialsSpec
        Havidrome.Subsonic.ClientSpec
        Havidrome.Subsonic.Fixtures
        Havidrome.Subsonic.ProtocolSpec

    build-depends:
        QuickCheck,
        base,
        bytestring,
        directory,
        filepath,
        havidrome,
        hspec,
        http-client,
        http-types,
        temporary,
        text,
        unix
